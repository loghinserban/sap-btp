{
  "name": "project",
  "version": "1.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-companymanagement": "cds watch --open companymanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy project --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-userview": "cds watch --open userview/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "destinations": true,
      "html5-repo": true
    },
    "server": {
      "body_parser": {
        "limit": "30mb"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}