<mvc:View
    controllerName="userview.controller.User"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
>
    <Page id="page" title="{i18n>title}">
        <content>
            <VBox class="sapUiResponsiveMargin sapUiSmallMarginTopBottom">
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button text="Edit Profile" type="Emphasized" press=".onOpenEditProfile" />
                    <Button text="Recommand a colleague" press=".onOpenAddReview" />
                    <Button text="Edit Your Skills" press=".onOpenEditSkills" />
                    <Button text="Upload CV" press=".onOpenUploadCV" />
                    <ToolbarSpacer />
                </OverflowToolbar>

                <l:Grid
                    defaultSpan="XL6 L6 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiMediumMarginTop"
                >
                    <Panel headerText="Your Info" class="sapUiResponsiveMargin">
                        <VBox class="sapUiSmallMargin">
                            <ObjectIdentifier
                                title="{view>/currentUser/firstName} {view>/currentUser/lastName}"
                                text="{view>/currentUser/email}"
                            />
                            <Text text="First Name: {view>/currentUser/firstName}" />
                            <Text text="Last Name: {view>/currentUser/lastName}" />
                            <Text text="Email: {view>/currentUser/email}" />
                            <Text text="Experience: {view>/currentUser/experience} years" />
                            <Text
                                text="Date of birth: {
                                  path: 'view>/currentUser/dateOfBirth',
                                  type: 'sap.ui.model.type.Date',
                                  formatOptions: { pattern: 'yyyy-MM-dd', UTC: false }
                                }"
                            />
                            <Text text="Department: {view>/currentUser/department/name}" />

                            <Title text="Skills" level="H5" class="sapUiSmallMarginTop" />
                            <List items="{view>/currentUser/skills}" noDataText="No skills assigned">
                                <StandardListItem
                                    title="{view>skill/name}"
                                    description="Rating: {view>rating}/5 | Last used: {
                                      path: 'view>lastUsed',
                                      type: 'sap.ui.model.type.Date',
                                      formatOptions: { pattern: 'yyyy-MM-dd', UTC: false }
                                    }"
                                />
                            </List>
                        </VBox>
                    </Panel>

                    <Panel headerText="My Reviews" class="sapUiResponsiveMargin">
                        <List items="{view>/currentUser/reviews}" noDataText="No reviews yet">
                            <ObjectListItem
                                title="{view>title}"
                                intro="Rating: {view>stars}/5"
                                number="{view>stars}"
                                numberUnit="★"
                            >
                                <attributes>
                                    <ObjectAttribute text="{view>content}" />
                                </attributes>
                            </ObjectListItem>
                        </List>
                    </Panel>
                </l:Grid>

                <VBox class="sapUiMediumMarginTop">
                    <SearchField
                        width="100%"
                        placeholder="Search users by name, email..."
                        liveChange=".onUserSearch"
                        search=".onUserSearch"
                    />

                    <Table
                        id="usersTable"
                        items="{path:'/Employees'}"
                        mode="None"
                        class="sapUiSmallMarginTop"
                    >
                        <columns>
                            <Column><Text text="First Name" /></Column>
                            <Column><Text text="Last Name" /></Column>
                            <Column><Text text="Email" /></Column>
                            <Column><Text text="Experience" /></Column>
                            <Column><Text text="Date of birth" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onUserPress">
                                <cells>
                                    <Text text="{firstName}" />
                                    <Text text="{lastName}" />
                                    <Text text="{email}" />
                                    <Text text="{experience}" />
                                    <Text
                                        text="{
                                          path: 'dateOfBirth',
                                          type: 'sap.ui.model.type.Date',
                                          formatOptions: { pattern: 'yyyy-MM-dd', UTC: false }
                                        }"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>