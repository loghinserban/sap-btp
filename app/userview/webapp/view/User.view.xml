<mvc:View
    controllerName="userview.controller.User"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <VBox class="sapUiResponsiveMargin sapUiSmallMarginTopBottom">
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Edit Profile"
                        type="Emphasized"
                        press=".onOpenEditProfile"
                    />
                    <Button
                        text="Recommand a colleague"
                        press=".onOpenAddReview"
                    />
                    <Button
                        text="Edit Your Skills"
                        press=".onOpenEditSkills"
                    />
                    <Button
                        text="Upload CV"
                        press=".onOpenUploadCV"
                    />
                    <ToolbarSpacer />
                </OverflowToolbar>

                <l:Grid
                    defaultSpan="XL6 L6 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiMediumMarginTop"
                >
                    <Panel
                        headerText="Your Info"
                        class="sapUiResponsiveMargin"
                    >
                        <VBox class="sapUiSmallMargin">
                            <ObjectIdentifier
                                title="{firstName} {lastName}"
                                text="{email}"
                            />
                            <Text text="First Name: {firstName}" />
                            <Text text="Last Name: {lastName}" />
                            <Text text="Email: {email}" />
                            <Text text="Experience: {experience}" />
                            <Text
                                text="Date of birth: {
                                    path: 'dateOfBirth',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { pattern: 'dd.MM.yyyy', UTC: true }
                                }"
                            />
                            <Text text="Department: {department/name}" />

                            <Title
                                text="Skills"
                                level="H5"
                                class="sapUiSmallMarginTop"
                            />
                            <List items="{skills}">
                                <StandardListItem
                                    title="{skill/name}"
                                    description="Rating: {rating}/5 | Last Used: { path: 'lastUsed', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy', UTC: true } }"
                                />
                            </List>
                        </VBox>
                    </Panel>

                    <Panel
                        headerText="My Reviews"
                        class="sapUiResponsiveMargin"
                    >
                        <List items="{reviews}">
                            <ObjectListItem
                                title="{title}"
                                intro="Rating: {stars}/5"
                                number="{stars}"
                                numberUnit="★"
                            >
                                <attributes>
                                    <ObjectAttribute text="{content}" />
                                </attributes>
                            </ObjectListItem>
                        </List>
                    </Panel>
                </l:Grid>

                <VBox class="sapUiMediumMarginTop">
                    <SearchField
                        width="100%"
                        placeholder="Search users by name, email..."
                        liveChange=".onUserSearch"
                        search=".onUserSearch"
                    />

                    <Table
                        id="usersTable"
                        items="{ path:'/Employees'}"
                        mode="None"
                        class="sapUiSmallMarginTop"
                    >
                        <columns>
                            <Column><Text text="First Name" /></Column>
                            <Column><Text text="Last Name" /></Column>
                            <Column><Text text="Email" /></Column>
                            <Column><Text text="Experience" /></Column>
                            <Column><Text text="Date of birth" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                type="Navigation"
                                press=".onUserPress"
                            >
                                <cells>
                                    <Text text="{firstName}" />
                                    <Text text="{lastName}" />
                                    <Text text="{email}" />
                                    <Text text="{experience}" />
                                    <Text
                                        text="{
                                            path: 'dateOfBirth',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: { pattern: 'dd.MM.yyyy', UTC: true }
                                        }"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>