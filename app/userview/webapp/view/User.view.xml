<mvc:View
    xmlns:cards="sap.f.cards"
    controllerName="userview.controller.User"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <VBox class="sapUiResponsiveMargin sapUiSmallMarginTopBottom">
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Edit Profile"
                        type="Emphasized"
                        press=".onOpenEditProfile"
                    />
                    <Button
                        text="Recommand a colleague"
                        press=".onOpenAddReview"
                    />
                    <Button
                        text="Edit Your Skills"
                        press=".onOpenEditSkills"
                    />
                    <Button
                        text="Upload CV"
                        press=".onOpenUploadCV"
                    />
                    <ToolbarSpacer />
                </OverflowToolbar>

                <l:Grid
                    defaultSpan="XL6 L6 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiMediumMarginTop"
                >
                    <Panel
                        headerText="Your Info"
                        class="sapUiResponsiveMargin"
                    >
                        <VBox class="sapUiSmallMargin">
                            <ObjectIdentifier
                                title="{view>/currentUser/firstName}"
                                text="{view>/currentUser/lastName}"
                            />
                            <Text text="First Name: {/loggedUser/firstName}" />
                            <Text text="Last Name: {/loggedUser/lastName}" />
                            <Text text="Email: {/loggedUser/email}" />
                            <Text text="Experience: {/loggedUser/experience}" />
                            <Text
                                text="Date of birth: {/loggedUser/dateOfBirth}"
                            />
                            <Title
                                text="Skills"
                                level="H5"
                                class="sapUiSmallMarginTop"
                            />
                            <List items="{view>/Skills}">
                                <StandardListItem
                                    title="{view>name}"
                                    description="Description: {view>description}"
                                />
                            </List>
                        </VBox>
                    </Panel>

                    <Panel
                        headerText="My Reviews"
                        class="sapUiResponsiveMargin"
                    >
                        <List items="{view>/Reviews}">
                            <ObjectListItem
                                title="{view>title}"
                                intro="Rating: {view>stars}/5"
                                number="{view>stars}"
                                numberUnit="★"
                            >
                                <firstStatus>
                                    <ObjectStatus text="{view>employee}" />
                                </firstStatus>
                                <attributes>
                                    <ObjectAttribute text="{view>content}" />
                                </attributes>
                            </ObjectListItem>
                        </List>
                    </Panel>
                </l:Grid>


                <VBox class="sapUiMediumMarginTop">
                    <SearchField
                        width="100%"
                        placeholder="Search users by name, email, skills..."
                        liveChange=".onUserSearch"
                        search=".onUserSearch"
                    />

                    <Table
                        id="usersTable"
                        items="{ path:'/Employees'}"
                        mode="None"
                        class="sapUiSmallMarginTop"
                    >
                        <columns>
                            <Column>
                                <Text text="First Name" />
                            </Column>
                            <Column>
                                <Text text="Last Name" />
                            </Column>
                            <Column>
                                <Text text="Email" />
                            </Column>
                            <Column>
                                <Text text="Experience" />
                            </Column>
                            <Column>
                                <Text text="Date of birth" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                type="Navigation"
                                press=".onUserPress"
                            >
                                <cells>
                                    <Text text="{firstName}" />
                                    <Text text="{lastName}" />
                                    <Text text="{email}" />
                                    <Text text="{experience}" />
                                    <Text text="{dateOfBirth}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
