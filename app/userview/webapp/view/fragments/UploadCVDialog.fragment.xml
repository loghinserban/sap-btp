<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
  <Dialog id="uploadCvDialog" title="Upload CV" contentWidth="34rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="Choose CV file (pdf/doc/docx, max 10MB)" />
        <u:FileUploader
          id="fuCv"
          width="100%"
          fileType="pdf,doc,docx"
          maximumFileSize="10"
          sameFilenameAllowed="true"
        />
      </VBox>
    </content>
    <beginButton>
      <Button text="Upload" type="Emphasized" press=".onUploadCv"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onCloseCvDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>