<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
  <Dialog id="uploadCvDialog" title="Import skills from your CV" contentWidth="48rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip
          text="Upload your CV and we read the skills out of it. Nothing is saved until you review the list and confirm."
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom"
        />

        <Label text="CV file (PDF or TXT, max 10MB)" labelFor="fuCv" />
        <u:FileUploader
          id="fuCv"
          width="100%"
          fileType="pdf,txt,md"
          maximumFileSize="10"
          sameFilenameAllowed="true"
          uploadOnChange="false"
          change=".onCvFileChange"
          typeMissmatch=".onCvTypeMismatch"
          fileSizeExceed=".onCvFileSizeExceed"
        />

        <Button
          id="btnAnalyzeCv"
          text="Read skills from CV"
          icon="sap-icon://request"
          type="Emphasized"
          press=".onAnalyzeCv"
          class="sapUiSmallMarginTop"
        />

        <VBox visible="{cv>/hasResults}" class="sapUiSmallMarginTop">
          <Title text="Detected skills" level="H5" />
          <Text
            text="Untick anything you do not want, and correct the rating or date before adding."
            class="sapUiTinyMarginTop sapUiSmallMarginBottom"
          />

          <Table
            id="tblCvSkills"
            items="{cv>/skills}"
            mode="None"
            noDataText="No skills were found in this CV."
          >
            <columns>
              <Column width="3rem" hAlign="Center"><Text text="Add" /></Column>
              <Column><Text text="Skill" /></Column>
              <Column width="9rem"><Text text="Rating" /></Column>
              <Column width="10rem" minScreenWidth="Tablet" demandPopin="true">
                <Text text="Last used" />
              </Column>
              <Column minScreenWidth="Desktop" demandPopin="true">
                <Text text="Found in CV" />
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <CheckBox selected="{cv>selected}" />
                  <ObjectIdentifier
                    title="{cv>name}"
                    text="{= ${cv>skillID} ? 'In skill catalog' : 'New skill' }"
                  />
                  <RatingIndicator maxValue="5" value="{cv>rating}" editable="true" />
                  <DatePicker
                    value="{cv>lastUsed}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="yyyy-MM-dd"
                    placeholder="Not dated"
                  />
                  <Text text="{cv>evidence}" wrapping="true" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button
        id="btnApplyCvSkills"
        text="Add selected skills"
        type="Emphasized"
        enabled="{cv>/hasResults}"
        press=".onApplyCvSkills"
      />
    </beginButton>
    <endButton>
      <Button text="Close" press=".onCloseCvDialog" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
