<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="editSkillsDialog" title="Edit Your Skills" contentWidth="34rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="Skill" />
        <ComboBox id="cbSkill" width="100%" items="{/Skills}">
          <items>
            <core:Item key="{ID}" text="{name}" />
          </items>
        </ComboBox>

        <Label text="Rating" class="sapUiSmallMarginTop" />
        <RatingIndicator id="riSkillRating" maxValue="5" value="3" />

        <Label text="Last Used" class="sapUiSmallMarginTop" />
        <DatePicker id="dpLastUsed" width="100%" valueFormat="yyyy-MM-dd" displayFormat="long"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="Save" type="Emphasized" press=".onSaveSkill"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onCloseSkillDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>