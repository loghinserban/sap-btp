<mvc:View
    controllerName="companymanagement.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="masterDataPage"
        title="{i18n>masterDataTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <IconTabBar
                id="masterDataTabs"
                expandable="false"
                class="sapUiResponsiveContentPadding"
            >
                <items>
                    <IconTabFilter
                        id="tabSkills"
                        text="{i18n>skillsTab}"
                        icon="sap-icon://competitor"
                    >
                        <Table
                            id="skillsMasterTable"
                            items="{/Skills}"
                        >
                            <headerToolbar>
                                <Toolbar id="skillsMasterToolbar">
                                    <Title
                                        id="skillsMasterTitle"
                                        text="{i18n>skillsTab}"
                                    />
                                    <ToolbarSpacer id="skillsMasterSpacer" />
                                    <SearchField
                                        id="skillsSearchField"
                                        width="15rem"
                                        placeholder="{i18n>searchByName}"
                                        search=".onSearchSkills"
                                        liveChange=".onSearchSkills"
                                    />
                                    <Button
                                        id="btnAddSkillMaster"
                                        text="{i18n>createSkill}"
                                        type="Emphasized"
                                        icon="sap-icon://add"
                                        press=".onAddSkill"
                                    />
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colSkillMasterName">
                                    <Text
                                        id="txtColSkillMasterName"
                                        text="{i18n>skillName}"
                                    />
                                </Column>
                                <Column
                                    id="colSkillMasterDesc"
                                    minScreenWidth="Tablet"
                                    demandPopin="true"
                                >
                                    <Text
                                        id="txtColSkillMasterDesc"
                                        text="{i18n>departmentDescription}"
                                    />
                                </Column>
                                <Column
                                    id="colSkillMasterUsage"
                                    hAlign="End"
                                    width="9rem"
                                    minScreenWidth="Tablet"
                                    demandPopin="true"
                                >
                                    <Text
                                        id="txtColSkillMasterUsage"
                                        text="{i18n>usageColumn}"
                                    />
                                </Column>
                                <Column
                                    id="colSkillMasterActions"
                                    hAlign="End"
                                >
                                    <Text
                                        id="txtColSkillMasterActions"
                                        text="{i18n>actions}"
                                    />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="skillMasterRow">
                                    <cells>
                                        <Text
                                            id="skillMasterName"
                                            text="{name}"
                                        />
                                        <Text
                                            id="skillMasterDesc"
                                            text="{description}"
                                        />
                                        <ObjectNumber
                                            id="skillMasterUsage"
                                            number="{usageCount}"
                                            unit="{i18n>usageUnitEmployees}"
                                            state="{path: 'usageCount', formatter: '.formatUsageState'}"
                                        />
                                        <HBox
                                            id="skillMasterActions"
                                            justifyContent="End"
                                        >
                                            <Button
                                                id="btnMergeSkillMaster"
                                                icon="sap-icon://combine"
                                                type="Transparent"
                                                tooltip="{i18n>mergeSkill}"
                                                press=".onMergeSkill"
                                            />
                                            <Button
                                                id="btnEditSkillMaster"
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="{i18n>edit}"
                                                press=".onEditSkill"
                                            />
                                            <Button
                                                id="btnDeleteSkillMaster"
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="{i18n>delete}"
                                                press=".onDeleteSkill"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                            <noData>
                                <IllustratedMessage
                                    id="skillsMasterNoData"
                                    illustrationType="sapIllus-NoEntries"
                                    title="{i18n>noSkillsTitle}"
                                    illustrationSize="Spot"
                                />
                            </noData>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter
                        id="tabDepartments"
                        text="{i18n>departmentsTab}"
                        icon="sap-icon://org-chart"
                    >
                        <Table
                            id="departmentsMasterTable"
                            items="{/Departments}"
                        >
                            <headerToolbar>
                                <Toolbar id="departmentsMasterToolbar">
                                    <Title
                                        id="departmentsMasterTitle"
                                        text="{i18n>departmentsTab}"
                                    />
                                    <ToolbarSpacer
                                        id="departmentsMasterSpacer"
                                    />
                                    <SearchField
                                        id="departmentsSearchField"
                                        width="15rem"
                                        placeholder="{i18n>searchByName}"
                                        search=".onSearchDepartments"
                                        liveChange=".onSearchDepartments"
                                    />
                                    <Button
                                        id="btnAddDepartmentMaster"
                                        text="{i18n>createDepartment}"
                                        type="Emphasized"
                                        icon="sap-icon://add"
                                        press=".onAddDepartment"
                                    />
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colDeptMasterName">
                                    <Text
                                        id="txtColDeptMasterName"
                                        text="{i18n>departmentName}"
                                    />
                                </Column>
                                <Column
                                    id="colDeptMasterDesc"
                                    minScreenWidth="Tablet"
                                    demandPopin="true"
                                >
                                    <Text
                                        id="txtColDeptMasterDesc"
                                        text="{i18n>departmentDescription}"
                                    />
                                </Column>
                                <Column
                                    id="colDeptMasterUsage"
                                    hAlign="End"
                                    width="9rem"
                                    minScreenWidth="Tablet"
                                    demandPopin="true"
                                >
                                    <Text
                                        id="txtColDeptMasterUsage"
                                        text="{i18n>usageColumn}"
                                    />
                                </Column>
                                <Column
                                    id="colDeptMasterActions"
                                    hAlign="End"
                                >
                                    <Text
                                        id="txtColDeptMasterActions"
                                        text="{i18n>actions}"
                                    />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="deptMasterRow">
                                    <cells>
                                        <Text
                                            id="deptMasterName"
                                            text="{name}"
                                        />
                                        <Text
                                            id="deptMasterDesc"
                                            text="{description}"
                                        />
                                        <ObjectNumber
                                            id="deptMasterUsage"
                                            number="{usageCount}"
                                            unit="{i18n>usageUnitEmployees}"
                                            state="{path: 'usageCount', formatter: '.formatUsageState'}"
                                        />
                                        <HBox
                                            id="deptMasterActions"
                                            justifyContent="End"
                                        >
                                            <Button
                                                id="btnEditDeptMaster"
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="{i18n>edit}"
                                                press=".onEditDepartment"
                                            />
                                            <Button
                                                id="btnDeleteDeptMaster"
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="{i18n>delete}"
                                                press=".onDeleteDepartment"
                                            />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                            <noData>
                                <IllustratedMessage
                                    id="departmentsMasterNoData"
                                    illustrationType="sapIllus-NoEntries"
                                    title="{i18n>noDepartmentsTitle}"
                                    illustrationSize="Spot"
                                />
                            </noData>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
