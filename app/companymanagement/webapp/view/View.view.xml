<mvc:View
    controllerName="companymanagement.controller.View"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns="sap.m"
    height="100%"
>
    <Page
        id="adminPage"
        showHeader="true"
        title="{i18n>adminPageTitle}"
        enableScrolling="true"
        class="sapUiResponsiveContentPadding"
        titleAlignment="Start"
        titleLevel="Auto"
        showFooter="true"
    >
        <content>
            <VBox
                id="adminContent"
                fitContainer="true"
            >
                <smartFilterBar:SmartFilterBar
                    id="smartFilterBar"
                    entitySet="Employees"
                    enableBasicSearch="true"
                    useToolbar="false"
                />

                <smartTable:SmartTable
                    id="employeeSmartTable"
                    entitySet="Employees"
                    smartFilterId="smartFilterBar"
                    tableType="ResponsiveTable"
                    header="{i18n>employeesTableHeader}"
                    showRowCount="true"
                    useVariantManagement="false"
                    useTablePersonalisation="true"
                    enableAutoBinding="true"
                    enableCopy="false"
                    requestAtLeastFields="ID"
                    initiallyVisibleFields="firstName,lastName,email,department/name,experience,dateOfBirth"
                    beforeRebindTable=".onBeforeRebindTable"
                >
                    <smartTable:layoutData>
                        <FlexItemData
                            id="employeeSmartTableLayoutData"
                            growFactor="1"
                            baseSize="0%"
                        />
                    </smartTable:layoutData>

                    <smartTable:customToolbar>
                        <OverflowToolbar
                            id="employeeTableToolbar"
                            width="100%"
                        >
                            <ToolbarSpacer id="employeeTableToolbarSpacer" />

                            <Button
                                id="btnMasterData"
                                text="{i18n>masterDataTitle}"
                                type="Transparent"
                                icon="sap-icon://settings"
                                press=".onNavToMasterData"
                            >
                                <layoutData>
                                    <OverflowToolbarLayoutData
                                        id="btnMasterDataLayout"
                                        priority="Low"
                                    />
                                </layoutData>
                            </Button>

                            <Button
                                id="btnSeedData"
                                text="{i18n>seedData}"
                                type="Transparent"
                                icon="sap-icon://download-from-cloud"
                                press=".onSeedData"
                            >
                                <layoutData>
                                    <OverflowToolbarLayoutData
                                        id="btnSeedDataLayout"
                                        priority="Low"
                                    />
                                </layoutData>
                            </Button>
                            <Button
                                id="btnGoToSearch"
                                text="{i18n>searchPageTitle}"
                                type="Transparent"
                                icon="sap-icon://search"
                                press=".onNavToSearch"
                            >
                                <layoutData>
                                    <OverflowToolbarLayoutData
                                        id="btnGoToSearchLayout"
                                        priority="Low"
                                    />
                                </layoutData>
                            </Button>
                            <Button
                                id="btnCreateDepartment"
                                text="{i18n>createDepartment}"
                                type="Transparent"
                                icon="sap-icon://add-folder"
                                press=".onOpenDepartmentDialog"
                            >
                                <layoutData>
                                    <OverflowToolbarLayoutData
                                        id="btnCreateDepartmentLayout"
                                        priority="Low"
                                    />
                                </layoutData>
                            </Button>
                            <Button
                                id="btnAddEmployee"
                                text="{i18n>addEmployee}"
                                type="Emphasized"
                                icon="sap-icon://add-employee"
                                press=".onOpenAddEmployeeDialog"
                            >
                                <layoutData>
                                    <OverflowToolbarLayoutData
                                        id="btnAddEmployeeLayout"
                                        priority="High"
                                    />
                                </layoutData>
                            </Button>
                        </OverflowToolbar>
                    </smartTable:customToolbar>

                    <Table
                        id="employeeTable"
                        mode="SingleSelectMaster"
                        selectionChange=".onItemPress"
                        growing="true"
                        growingThreshold="25"
                        growingScrollToLoad="true"
                        sticky="ColumnHeaders,HeaderToolbar"
                    >
                        <noData>
                            <IllustratedMessage
                                id="employeeTableNoData"
                                illustrationType="sapIllus-NoEntries"
                                title="{i18n>noEmployeesTitle}"
                                description="{i18n>noEmployeesDescription}"
                            />
                        </noData>
                    </Table>
                </smartTable:SmartTable>
            </VBox>
        </content>
    </Page>
</mvc:View>
